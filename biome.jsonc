{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {"enabled": true, "clientKind": "git", "useIgnoreFile": true},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"package.json",
			"tsconfig.json",
			"components.json",
			"biome.jsonc",
			".oxlintrc.json",
			"src/**/*.{ts,tsx,cts,css,json}",
			"tests/**/*.{ts,tsx,json}",
			"scripts/**/*.{ts,mjs,js,json}",
			"packages/yt-dlp-bridge/**/*.{ts,mjs,js,json}",
			"packages/ytdlp-errors/**/*.{ts,mjs,js,json}",
			"packages/events/**/*.{ts,mjs,js,json}",
			"packages/shared-types/**/*.{ts,mjs,js,json}",
			"packages/media/**/*.{ts,mjs,js,json}",
			"packages/metadata/**/*.{ts,mjs,js,json}",
			"packages/thumbnail/**/*.{ts,mjs,js,json}",
			"packages/library/**/*.{ts,mjs,js,json}",
			"packages/viewer/**/*.{ts,mjs,js,json}",
			"packages/converter/**/*.{ts,mjs,js,json}",
			"packages/sources/**/*.{ts,mjs,js,json}",
			"packages/media-indexer/**/*.{ts,mjs,js,json}",
			"packages/search/**/*.{ts,mjs,js,json}",
			"packages/pipelines/**/*.{ts,mjs,js,json}",
			"packages/application/**/*.{ts,mjs,js,json}",
			"packages/core/**/*.{ts,mjs,js,json}",
			"packages/downloader/**/*.{ts,mjs,js,json}",
			"packages/plugins/**/*.{ts,mjs,js,json}",
			"packages/ai/**/*.{ts,mjs,js,json}",
			"packages/sync/**/*.{ts,mjs,js,json}",
			"packages/cloud/**/*.{ts,mjs,js,json}",
			"packages/auth/**/*.{ts,mjs,js,json}",
			"packages/share/**/*.{ts,mjs,js,json}",
			"packages/import-export/**/*.{ts,mjs,js,json}",
			"infrastructure/sqlite/**/*.{ts,mjs,js,json}",
			"infrastructure/filesystem/**/*.{ts,mjs,js,json}",
			"infrastructure/yt-dlp/**/*.{ts,mjs,js,json}",
			"infrastructure/ffmpeg/**/*.{ts,mjs,js,json}",
			"infrastructure/network/**/*.{ts,mjs,js,json}",
			"apps/desktop/**/*.{ts,mjs,js,json,tsx}",
			"electron.vite.config.ts",
			"vitest.config.mts",
			"playwright.config.ts",
			"playwright.browser.config.ts"
		]
	},
	"formatter": {"enabled": true, "indentStyle": "tab", "indentWidth": 2, "lineWidth": 320, "bracketSpacing": false, "expand": "never"},
	"javascript": {"formatter": {"quoteStyle": "single", "jsxQuoteStyle": "double", "semicolons": "asNeeded", "trailingCommas": "none", "arrowParentheses": "asNeeded", "bracketSpacing": false, "expand": "never", "lineWidth": 320}},
	"json": {"formatter": {"lineWidth": 320, "bracketSpacing": false, "expand": "never"}},
	"css": {"parser": {"tailwindDirectives": true}, "formatter": {"lineWidth": 320}},
	"linter": {"enabled": false},
	"assist": {"enabled": false}
}
