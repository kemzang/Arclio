<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.kemzang.Arclio</id>

  <name>Arclio</name>
  <summary>YouTube downloader for video, audio, and subtitles</summary>
  <summary xml:lang="de">YouTube Downloader für Video, Audio und Untertitel</summary>
  <summary xml:lang="es">Descargador de YouTube para vídeo, audio y subtítulos</summary>
  <summary xml:lang="fr">Téléchargeur YouTube pour vidéo, audio et sous-titres</summary>
  <summary xml:lang="hi">वीडियो, ऑडियो और सबटाइटल के लिए YouTube डाउनलोडर</summary>
  <summary xml:lang="ja">動画・音声・字幕に対応した YouTube ダウンローダー</summary>
  <summary xml:lang="ru">Загрузчик YouTube — видео, аудио и субтитры</summary>
  <summary xml:lang="uk">Завантажувач YouTube — відео, аудіо та субтитри</summary>
  <summary xml:lang="zh">下载 YouTube 视频、音频和字幕</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Arclio is a free open-source YouTube downloader built around a simple step-by-step
      wizard. Paste a URL, pick a format and quality, choose where to save, and download —
      no command-line flags, no terminal required.
    </p>
    <p>Features:</p>
    <ul>
      <li>Download YouTube videos in up to 4K, 1080p60, and HDR</li>
      <li>Extract audio in MP3, M4A, Opus, and other formats</li>
      <li>Download subtitles in any language, embedded or as sidecar files</li>
      <li>Parallel download queue with real-time progress</li>
      <li>Supports YouTube Shorts, playlists, and live archives</li>
      <li>Powered by yt-dlp under the hood, kept up to date automatically</li>
      <li>Works on Linux, Windows, and macOS</li>
      <li>Available in 9 languages</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.kemzang.Arclio.desktop</launchable>

  <url type="homepage">https://github.com/kemzang/Arclio</url>
  <url type="bugtracker">https://github.com/kemzang/Arclio/issues</url>

  <keywords>
    <keyword>youtube</keyword>
    <keyword>downloader</keyword>
    <keyword>video</keyword>
    <keyword>audio</keyword>
    <keyword>music</keyword>
    <keyword>mp3</keyword>
    <keyword>mp4</keyword>
    <keyword>subtitle</keyword>
    <keyword>playlist</keyword>
    <keyword>shorts</keyword>
    <keyword>4K</keyword>
    <keyword>HDR</keyword>
    <keyword>yt-dlp</keyword>
  </keywords>

