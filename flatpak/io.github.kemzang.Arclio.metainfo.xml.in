      <image>https://raw.githubusercontent.com/kemzang/Arclio/main/build/Main-screenshot.png</image>
    </screenshot>
    <screenshot>
      <caption>Reusable download profiles — save format, quality, and output presets</caption>
      <image>https://raw.githubusercontent.com/kemzang/Arclio/main/build/Download-profiles-screenshot.png</image>
    </screenshot>
    <screenshot>
      <caption>Multi-language audio tracks — pick the exact audio language a video ships</caption>
      <image>https://raw.githubusercontent.com/kemzang/Arclio/main/build/Multi-lang-audio-support-screenshot.png</image>
    </screenshot>
    <screenshot>
      <caption>Surround / Dolby audio detected and preserved</caption>
      <image>https://raw.githubusercontent.com/kemzang/Arclio/main/build/Dolby-audio-support-screenshot.png</image>
    </screenshot>
    <screenshot>
      <caption>Bulk URL mode — paste a list, auto-dedupe, queue them all at once</caption>
      <image>https://raw.githubusercontent.com/kemzang/Arclio/main/build/Bulk-urls-mode-screenshot.png</image>
    </screenshot>
    <screenshot>
      <caption>Parallel download queue with live progress</caption>
      <image>https://raw.githubusercontent.com/kemzang/Arclio/main/build/Downloading-in-parallel-screenshot.png</image>
    </screenshot>
  </screenshots>

  <releases>
__RELEASES__
